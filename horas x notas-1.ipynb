    "import matplotlib.pyplot as plt\n",
    "\n",
    "horas = [1, 2, 3, 4, 5, 6, 7, 8]\n",
    "notas = [50, 55, 60, 65, 70, 78, 82, 90]\n",
    "\n",
    "plt.scatter(horas, notas)\n",
    "\n",
    "plt.xlabel('Horas de estudo')\n",
    "plt.ylabel('Nota')\n",
    "plt.title('Horas de estudo × Nota')\n",
    "\n",
    "plt.show()"
   ]
  }
